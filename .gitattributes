# LF everywhere text is compared byte for byte or executed on Linux runners.
*.sh text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
Makefile text eol=lf

# Binary files
*.png binary
*.webp binary
*.ico binary
LICENSE binary
